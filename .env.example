# Variables requises sur Vercel (dashboard → Settings → Environment Variables)
# DATABASE_URI=postgresql://neondb_owner:XXXXX@ep-super-credit-ash6zcne.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URI=postgres://user:XXXXX@host:5432/dbname
PAYLOAD_SECRET=XXXXX

# Remplacer XXXXX par le vrai mot de passe Neon / Postgres.
# Attention : URI doit commencer par postgresql:// (pas tpostgresql://)

# Portail CNSS des professionnels de santé (FSE) — NEXT_PUBLIC_* = build-time :
# un changement sur Coolify nécessite un REBUILD du service frontend.
# Par défaut : https://portailps.cnss.ma/portailps/Authentification.xhtml
# NEXT_PUBLIC_CNSS_PORTAL_URL=

# GlitchTip (error tracking / uptime) — DSN du projet Sentry-compatible,
# requis par @sentry/nextjs (sentry.client.config.ts / sentry.server.config.ts).
# Si absent, le fallback dans le code est utilisé.
# NEXT_PUBLIC_GLITCHTIP_DSN=http://98904b9f42634ec09db0eea9e2a2e4de@glitch.etabibi.ma/1
